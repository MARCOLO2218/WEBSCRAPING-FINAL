{
  "name": "facenco-energy-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node node_modules/typescript/bin/tsc && node dist/scrape-facenco-energy.js",
    "catalog": "node node_modules/typescript/bin/tsc && node dist/catalog-server.js",
    "build": "tsc",
    "scrape": "node node_modules/typescript/bin/tsc && node dist/scrape-facenco-energy.js",
    "test": "node node_modules/typescript/bin/tsc && node --test dist/specs/*.test.js",
    "test:curacao-dom": "node node_modules/typescript/bin/tsc && node --test dist/specs/browser/la-curacao-nc-*.test.js",
    "pilot:curacao-nc": "node node_modules/typescript/bin/tsc && node scripts/curacao-nc-pilot-preview.mjs",
    "pilot:nicaragua": "node node_modules/typescript/bin/tsc && node scripts/nicaragua-stores-pilot.mjs",
    "audit:walmart-nc-filters": "node scripts/walmart-nc-filter-audit.mjs",
    "pilot:walmart-hn": "node node_modules/typescript/bin/tsc && node scripts/walmart-hn-pilot.mjs",
    "sprint:report": "node node_modules/typescript/bin/tsc && node scripts/sprint-status-report.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "pg": "^8.22.0",
    "playwright": "^1.55.0",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0"
  }
